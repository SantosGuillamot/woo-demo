{
	"version": 2,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "620px",
			"wideSize": "1000px"
		},
		"spacing": {
			"units": [ "%", "px", "em", "rem", "vh", "vw" ]
		},
		"color": {
			"palette": [
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "White"
				},
				{
					"slug": "black",
					"color": "#000000",
					"name": "Black"
				},
				{
					"slug": "woo-purple-10",
					"color": "#D1C1FF",
					"name": "Woo Purple 10"
				},
				{
					"slug": "woo-purple-40",
					"color": "#873EFF",
					"name": "Woo Purple 40"
				},
				{
					"slug": "woo-purple-50",
					"color": "#720EEC",
					"name": "Woo Purple 50"
				},
				{
					"slug": "woo-purple-70",
					"color": "#5007AA",
					"name": "Woo Purple 70"
				},
				{
					"slug": "woo-purple-90",
					"color": "#2C045D",
					"name": "Woo Purple 90"
				}
			]
		},
		"typography": {
			"fluid": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"name": "Proxima Nova",
					"slug": "proxima-nova",
					"fontFamily": "Proxima Nova, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/proximanova_regular.woff2"
							],
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontFamily": "Proxima Nova"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "14px",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "18px",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "24px",
					"name": "Large"
				},
				{
					"slug": "extra-large",
					"size": "64px",
					"name": "Extra Large"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|proxima-nova",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "26px",
			"fontWeight": "400"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}
